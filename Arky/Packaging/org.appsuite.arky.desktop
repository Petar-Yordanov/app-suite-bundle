[Desktop Entry]
Type=Application
Name=Arky
Comment=Lightweight archive manager
Exec=arky %F
Terminal=false
Categories=Utility;Archiving;
MimeType=application/zip;application/x-7z-compressed;application/x-rar;application/vnd.rar;application/x-tar;application/gzip;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-bzip-compressed-tar;application/x-cpio;application/x-archive;application/vnd.ms-cab-compressed;application/x-iso9660-image;application/x-xar;application/x-lha;application/x-xz;application/zstd;application/x-bzip2;
Actions=ExtractHere;
[Desktop Action ExtractHere]
Name=Extract here
Exec=arky --extract-here %f
