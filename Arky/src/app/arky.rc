// Visible in Windows Explorer > Properties > Details for Arky.exe.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,9,0,0
 PRODUCTVERSION 0,9,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Arky"
            VALUE "FileDescription", "Arky is a crossplatform archive manager supporting a range of formats."
            VALUE "FileVersion", "0.9.0.0"
            VALUE "InternalName", "Arky"
            VALUE "OriginalFilename", "Arky.exe"
            VALUE "ProductName", "Arky"
            VALUE "ProductVersion", "0.9.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
